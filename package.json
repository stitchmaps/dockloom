{
  "name": "dockloom",
  "version": "0.2.0",
  "private": true,
  "description": "A local-first desktop workspace for SSH and Docker Compose deployments",
  "author": "Dockloom contributors",
  "license": "MIT",
  "type": "module",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build && node scripts/build-electron.mjs",
    "test": "tsx --test tests/*.test.ts",
    "test:integration": "tsx tests/integration.ts",
    "test:ui": "tsx tests/ui.ts",
    "start": "electron .",
    "package": "npm run build && electron-builder --win portable --x64"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "lucide-react": "^0.468.0",
    "yaml": "^2.8.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^42.0.0",
    "electron-builder": "^26.0.0",
    "esbuild": "^0.25.0",
    "playwright": "^1.56.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  },
  "build": {
    "appId": "dev.dockloom.desktop",
    "productName": "Dockloom",
    "directories": { "output": "release" },
    "files": ["dist/**/*", "dist-electron/**/*", "assets/icon.png", "package.json"],
    "win": { "target": "portable", "signAndEditExecutable": false, "icon": "assets/icon.ico" }
  }
}
